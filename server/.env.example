# Server environment — copy to server/.env and fill in values
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/social_media_db
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_EXPIRE=7d
CORS_ORIGINS=http://localhost:5000
REGISTRATION_INVITE_CODES=INTERN2026,DEMO2026
ADMIN_INVITE_CODES=ADMIN2026
