# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/connecthub_db

# Security & JWT Secrets (Change these in production!)
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_REFRESH_SECRET=your_secure_random_refresh_token_secret_here
JWT_EXPIRE=7d

# Access Control & Invite Codes
REGISTRATION_INVITE_CODES=CONNECT2026,DEV2026,SANDBOX2026
ADMIN_INVITE_CODES=ADMIN2026_MASTER

# Operations & Logging
LOG_LEVEL=info
